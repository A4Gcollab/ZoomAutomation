# ============================================
# YTZ AUTOMATION - ENVIRONMENT CONFIGURATION
# ============================================

# ZOOM CREDENTIALS (Server-to-Server OAuth)
# Add as many accounts as needed (ZOOM_1_, ZOOM_2_, etc.)
ZOOM_1_ACCOUNT_ID=your_account_id_here
ZOOM_1_CLIENT_ID=your_client_id_here
ZOOM_1_CLIENT_SECRET=your_client_secret_here

# ZOOM_2_ACCOUNT_ID=second_account_id
# ZOOM_2_CLIENT_ID=second_client_id
# ZOOM_2_CLIENT_SECRET=second_client_secret

# GOOGLE DRIVE
DRIVE_ROOT_FOLDER_ID=your_drive_folder_id_here
TRANSCRIPTS_FOLDER_NAME=Transcripts   # Dedicate folder for transcripts

# GOOGLE DOCS LOGGING (Optional - for collaborative logging)
GOOGLE_DOCS_LOG_ID=your_google_doc_id_here
ENABLE_GOOGLE_DOCS_LOGGING=false

# DRIVE ORGANIZATION
DRIVE_USE_CATEGORY_FOLDERS=true
DRIVE_DEFAULT_CATEGORY=General

# AUTOMATIC DELETION SETTINGS
# WARNING: Set to true only after testing!
ENABLE_AUTO_DELETE=false
DELETE_DELAY_HOURS=24

# YOUTUBE UPLOAD SETTINGS
UPLOAD_DELAY_SECONDS=30
YOUTUBE_PRIVACY_STATUS=unlisted

# YOUTUBE PROCESSING SETTINGS
ENABLE_ADAPTIVE_WAIT=true
MAX_YOUTUBE_PROCESSING_WAIT=300

# ZOHO INTEGRATION (Optional - for HR notifications)
ZOHO_CLIQ_WEBHOOK_URL=your_zoho_webhook_url_here
ENABLE_ZOHO_INTEGRATION=false

# OPERATIONAL SETTINGS
CHECK_INTERVAL=3600
