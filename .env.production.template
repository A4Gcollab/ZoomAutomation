# ============================================
# YTZ AUTOMATION - PRODUCTION CONFIGURATION
# ============================================
# Copy this to .env on your production server

# --- ZOOM CONFIGURATION ---
ZOOM_1_ACCOUNT_ID=your_account_id_here
ZOOM_1_CLIENT_ID=your_client_id_here
ZOOM_1_CLIENT_SECRET=your_client_secret_here

# Zoom Account 2 (optional)
# ZOOM_2_ACCOUNT_ID=second_account_id
# ZOOM_2_CLIENT_ID=second_client_id
# ZOOM_2_CLIENT_SECRET=second_client_secret

# --- GOOGLE CONFIGURATION ---
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id

# Google Drive Configuration (REQUIRED)
DRIVE_ROOT_FOLDER_ID=your_drive_folder_id_here
DRIVE_AUTH_MODE=service_account
ENABLE_DRIVE_UPLOAD=true

# Google Sheets Integration
GOOGLE_SHEET_ID=your_sheet_id_here
ENABLE_SHEETS_INTEGRATION=true

# Admin Configuration
ADMIN_EMAILS=admin@example.com,admin2@example.com

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Operational Settings
CHECK_INTERVAL=3600
ENVIRONMENT=production

# YouTube Settings
YOUTUBE_PRIVACY_STATUS=unlisted
ENABLE_ADAPTIVE_WAIT=true
MAX_YOUTUBE_PROCESSING_WAIT=300

# Deletion Settings
ENABLE_AUTO_DELETE=false
DELETE_DELAY_HOURS=24

# Firebase Configuration (for frontend auth)
GEMINI_API_KEY=your_gemini_api_key
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
