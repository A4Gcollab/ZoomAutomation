# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
# These are installed from package.json and should not be in version control.
/node_modules
/.pnp
.pnp.js

# Build artifacts
# These are generated when you build or run your app.
/.next/
/out/

# Production build
/build

# Miscellaneous
.DS_Store
*.pem

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript cache
*.tsbuildinfo

# Next.js generated type file
next-env.d.ts

# Local environment variables
# It's a security risk to commit these. Create a .env.example file instead.
# For now, these are commented out as requested so you can commit your initial setup.
# You should uncomment these lines before you add any real secrets.
# .env.local
# .env.development.local
# .env.test.local
# .env.production.local

# Vercel deployment folder
.vercel
